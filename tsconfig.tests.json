{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "rootDir": ".",
    "outDir": ".omx/tests-dist",
    "noEmit": false,
    "incremental": false
  },
  "include": ["tests/**/*.ts"],
  "exclude": ["node_modules"]
}
