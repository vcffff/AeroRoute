# Choose explicitly for `npm run build` / `npm start`.
# Local demo is NOT a deployed multi-instance database or verified payment system.
AEROROUTE_MODE=demo
# Public HTTPS origin for deployments behind a reverse proxy, no trailing slash.
# AEROROUTE_APP_ORIGIN=https://your-domain.example
# Optional absolute path to the local single-process demo data file.
# AEROROUTE_DEMO_FILE=.aeroroute/demo.json

# Set AEROROUTE_MODE=firestore only after configuring Firebase Auth + Firestore.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Quote and use escaped \n between PEM lines, never commit real credentials.
FIREBASE_PRIVATE_KEY=
# Or use GOOGLE_APPLICATION_CREDENTIALS with Application Default Credentials.
# Real escrow is not implemented. Payment/payout fail closed in Firestore mode.
